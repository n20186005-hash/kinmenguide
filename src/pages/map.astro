---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { areaNames } from '../data/site';
import { mapLink } from '../lib/content';
const entries=(await getCollection('attractions')).sort((a,b)=>a.data.order-b.data.order);
---
<Base title="金門景點地圖｜依五個鄉鎮找下一站" description="依金城、金湖、金沙、金寧與烈嶼探索金門核心景點，查看位置與導航連結。先選同區景點，再搭配金門交通與路線指南，減少來回繞路。" image="bridge" breadcrumbs={[{name:'景點地圖'}]}>
<div class="shell pb-16"><Breadcrumb items={[{name:'景點地圖'}]}/><header class="article-header"><span class="eyebrow">FIND YOUR WAY AROUND</span><h1>把下一站，放回地圖上</h1><p class="article-lead">先選一個地區，再把喜歡的景點串起來。地圖只標位置，實際路況與開放仍請行前確認。</p></header><div class="map-consent" id="map-consent"><h2>從金門本島，看到小金門</h2><p>點擊後載入 OpenStreetMap，該服務將接收連線資訊。</p><button type="button" class="button" id="load-map">載入互動地圖</button><a class="text-link" href="https://www.openstreetmap.org/#map=12/24.452/118.338" target="_blank" rel="noopener noreferrer">直接在 OpenStreetMap 開啟</a></div><div id="map-container" hidden><iframe class="map-frame" id="kinmen-map" title="金門地區互動地圖" loading="lazy" referrerpolicy="no-referrer" data-src="https://www.openstreetmap.org/export/embed.html?bbox=118.18%2C24.37%2C118.48%2C24.55&amp;layer=mapnik"></iframe><p class="small">地圖資料 © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap 貢獻者</a> · 選擇下方景點可在圖中顯示位置。</p></div><div class="filter-bar"><div class="filter-chips" role="group" aria-label="地圖景點地區">{Object.entries(areaNames).map(([id,name])=><button type="button" class="chip" data-map-area={id} aria-pressed={id==='all'}>{name}</button>)}</div><span class="small" id="map-count" aria-live="polite">12 個景點</span></div><div class="map-points">{entries.map(e=><article class="map-point" data-area={e.data.area}><span class="eyebrow">{areaNames[e.data.area]}</span><h2>{e.data.title}</h2><p>建議停留 {e.data.duration}</p><div class="flex flex-wrap gap-3"><a href={`/attractions/${e.id}/`}>閱讀指南</a><a href={mapLink(e.data.coordinates.lat,e.data.coordinates.lng)} target="_blank" rel="noopener noreferrer">Google 地圖</a><button type="button" class="text-link" data-pin={`${e.data.coordinates.lat},${e.data.coordinates.lng}`}>圖上查看</button></div></article>)}</div><noscript><p>您仍可使用各景點的 Google 地圖連結導航。篩選與嵌入地圖需啟用 JavaScript。</p></noscript></div>
</Base>
<script>
const iframe=document.querySelector<HTMLIFrameElement>('#kinmen-map');
function loadMap(lat?:number,lng?:number){if(!iframe)return;iframe.src=lat&&lng?`https://www.openstreetmap.org/export/embed.html?bbox=${lng-.014}%2C${lat-.01}%2C${lng+.014}%2C${lat+.01}&layer=mapnik&marker=${lat}%2C${lng}`:iframe.dataset.src!;document.querySelector<HTMLElement>('#map-consent')!.hidden=true;document.querySelector<HTMLElement>('#map-container')!.hidden=false;}
document.querySelector('#load-map')?.addEventListener('click',()=>loadMap());
document.querySelectorAll<HTMLButtonElement>('[data-pin]').forEach(b=>b.addEventListener('click',()=>{const [lat,lng]=b.dataset.pin!.split(',').map(Number);loadMap(lat,lng);iframe?.scrollIntoView({behavior:window.matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth',block:'center'});}));
const filters=[...document.querySelectorAll<HTMLButtonElement>('[data-map-area]')];filters.forEach(b=>b.addEventListener('click',()=>{const area=b.dataset.mapArea;let n=0;document.querySelectorAll<HTMLElement>('.map-point').forEach(p=>{p.hidden=area!=='all'&&p.dataset.area!==area;if(!p.hidden)n++;});filters.forEach(f=>f.setAttribute('aria-pressed',String(f===b)));document.querySelector('#map-count')!.textContent=`${n} 個景點`;}));
</script>
