---
import ArrivalGuide from '../components/ArrivalGuide.astro';
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Card from '../components/Card.astro';
import Icon from '../components/Icon.astro';
import { allEntries } from '../lib/content';
const entries = await allEntries();
const highlights = ['shanhou-folk-culture-village','zhaishan-tunnel','juguang-tower','jiugong-tunnel'].map(id => entries.find(e => e.collection === 'attractions' && e.id === id)!);
const newStops = ['jiangong-islet','gugang-tower','kincheng-tea-walk','houpu-night-walk'].map(id=>entries.find(e=>e.id===id)!);
const areas = [{id:'kincheng',name:'金城',image:'mofan',text:'老街日常・僑鄉洋樓'},{id:'jinhu',name:'金湖',image:'taiwu',text:'山林步道・小鎮生活'},{id:'jinsha',name:'金沙',image:'shanhou',text:'紅磚古厝・北端海岸'},{id:'jinning',name:'金寧',image:'guningtou',text:'戰地記憶・聚落風景'},{id:'lieyu',name:'烈嶼',image:'bridge',text:'跨海而來・小島慢遊'}];
---
<Base>
  <section class="hero shell"><div class="hero-grid"><div class="hero-copy"><span class="hero-kicker">金門旅遊攻略 · KINMEN ISLAND GUIDE</span><h1>在金門，<br/><span class="hero-title-line">把日子<em>過慢一點。</em></span></h1><p class="hero-lead">走過紅磚古厝，聽見坑道裡的回音。<br/>從金門本島到小金門，景點、路線、在地味道，陪你慢慢安排一趟島嶼旅行。</p><div class="hero-buttons"><a class="button" href="/itineraries/kinmen-three-days-two-nights/">探索三天兩夜行程</a><a class="button button-light" href="/guides/first-time-visitor/">初訪金門指南</a></div><div class="hero-foot"><Icon name="compass" size={18}/><span>24° N / 118° E &nbsp; 一座島，值得多留幾天</span></div></div><figure class="hero-photo"><Photo name="shanhou" eager sizes="(max-width: 760px) 100vw, 60vw"/><span class="hero-side">THE ISLAND, AT YOUR OWN PACE</span><figcaption class="photo-note"><Icon name="pin" size={24}/><div><span>島嶼風景 01 / 金沙</span><strong>山后，紅磚裡的慢時光</strong></div></figcaption></figure></div>
  <form class="planner" action="/plan/" method="get"><div><h2>你的金門，想怎麼玩？</h2><p>從天數與移動方式，找到一條適合的路線。</p></div><label>準備留幾天<select name="days"><option value="1">一日輕旅行</option><option value="2">兩天一夜</option><option value="3" selected>三天兩夜</option><option value="4">四天三夜</option></select></label><label>喜歡怎麼移動<select name="mode"><option value="car">汽車自駕</option><option value="scooter">機車慢遊</option><option value="transit">公車與步行</option></select></label><button class="button button-dark" type="submit">找到我的路線</button></form></section>
  <section class="shell section" style="padding-top:30px"><div class="home-intro"><a href="/guides/first-time-visitor/" class="intro-item"><span>01</span><div><h2>第一次來，從這裡開始</h2><p>先認識五個鄉鎮，再決定住宿與交通。</p><span class="text-link">閱讀初訪指南</span></div></a><a href="/guides/how-many-days/" class="intro-item"><span>02</span><div><h2>不趕路，玩幾天剛剛好</h2><p>一天到四天，給不同步調的旅行提案。</p><span class="text-link">比較旅行天數</span></div></a><a href="/map/" class="intro-item"><span>03</span><div><h2>把喜歡的地方，順路串起</h2><p>按地區找景點，少一點折返，多一點停留。</p><span class="text-link">打開景點地圖</span></div></a></div></section>
  <div class="shell"><ArrivalGuide/></div>
  <section class="section shell" style="padding-top:0"><div class="section-heading"><div><span class="eyebrow">PLACES WITH A STORY</span><h2>有些風景，值得親自走一趟</h2><p>聚落、戰地、山海，都是金門的不同模樣。</p></div><a href="/attractions/" class="text-link">探索全部景點</a></div><div class="card-grid four">{highlights.map(entry => <Card entry={entry} compact/>)}</div></section>
  <section class="section shell" style="padding-top:0"><div class="section-heading"><div><span class="eyebrow">MORE OF THE ISLAND</span><h2>從一杯奶茶，到一座潮汐小島</h2><p>新的散步提案，把小巷、湖畔與夜遊放進旅程。</p></div><a class="text-link" href="/food/">看看店家與在地味道</a></div><div class="card-grid four">{newStops.map(entry=><Card entry={entry} compact/>)}</div></section>
  <section class="editorial-band"><div class="shell editorial-grid"><div class="editorial-photo"><Photo name="shuitou" sizes="(max-width: 760px) 100vw, 50vw"/><span class="caption">水頭聚落 · 巷弄之間，慢慢看</span></div><div><span class="eyebrow">THE FIRST JOURNEY / 3 DAYS</span><h2>三天兩夜，<br/>剛好開始喜歡金門。</h2><p>第一次來，把經典放進行程，也為一杯茶、一段海風和意外遇見的小巷留白。</p><ol class="day-preview"><li><span>Day 01</span><div><strong>金城與水頭，走進紅磚日常</strong><small>莒光樓 / 翟山坑道 / 水頭聚落 / 模範街</small></div></li><li><span>Day 02</span><div><strong>金沙與金湖，聽島嶼說故事</strong><small>山后聚落 / 獅山砲陣地 / 馬山觀測所</small></div></li><li><span>Day 03</span><div><strong>跨海到烈嶼，換一種步調</strong><small>金門大橋 / 九宮坑道 / 小島午餐</small></div></li></ol><a class="button" href="/itineraries/kinmen-three-days-two-nights/">查看完整三天兩夜行程</a></div></div></section>
  <section class="section shell"><div class="section-heading"><div><span class="eyebrow">STAY FOR A DAY. OR A LITTLE LONGER.</span><h2>留幾天，就有幾種走法</h2></div><a href="/itineraries/" class="text-link">全部行程</a></div><div class="duration-options">{[['1 日','kinmen-one-day','金城走讀，一次初相遇'],['2 天 1 夜','kinmen-two-days-one-night','一西一東，週末小旅行'],['3 天 2 夜','kinmen-three-days-two-nights','經典初訪，留一點彈性'],['4 天 3 夜','kinmen-four-days-three-nights','山林海岸，都慢慢看']].map(([days,id,text]) => <a class="duration-link" href={`/itineraries/${id}/`}><strong>{days}</strong><span>{text}</span></a>)}</div></section>
  <section class="section shell" style="padding-top:20px"><div class="section-heading"><div><span class="eyebrow">ONE ISLAND JOURNEY, FIVE DIFFERENT RHYTHMS</span><h2>下一站，想去哪一個金門？</h2></div><a href="/areas/" class="text-link">認識五個鄉鎮</a></div><div class="area-strip">{areas.map(a => <a href={`/areas/${a.id}/`}><Photo name={a.image}/><h3>{a.name}</h3><p>{a.text}</p></a>)}</div></section>
  <section class="soft-section section"><div class="shell"><div class="section-heading"><div><span class="eyebrow">THE EVERYDAY ISLAND</span><h2>旅行的日常，也安排得剛剛好</h2></div></div><div class="planning-grid"><div class="planning-tile"><Photo name="bridge"/><div><h3>移動，決定旅行的步調</h3><p>租機車、開車，或公車加步行，找到舒服的方式。</p><a href="/transport/" class="text-link">看交通指南</a></div></div><div class="planning-tile"><Photo name="food"/><div><h3>金門的味道，慢慢嚐</h3><p>一碗熱粥、一份燒餅，再把海味留給下一餐。</p><a href="/food/" class="text-link">探索在地美食</a></div></div><div class="planning-tile"><Photo name="guesthouse"/><div><h3>今晚，住進島嶼生活</h3><p>老城的便利，或古厝的安靜，先選喜歡的日常。</p><a href="/hotels/" class="text-link">找到住宿區域</a></div></div><div class="planning-tile"><Photo name="deyue"/><div><h3>不只路過，聽一段故事</h3><p>聚落散步、戰地導覽，讓在地視角豐富旅程。</p><a href="/tours/" class="text-link">看看在地體驗</a></div></div></div><div class="mt-8 text-center"><a href="/car-rental/" class="text-link">準備自駕？先讀金門租車攻略</a></div></div></section>
  <section class="section shell"><div class="section-heading"><div><span class="eyebrow">A FEW NOTES BEFORE YOU GO</span><h2>出發前，再看一眼</h2></div><a href="/guides/" class="text-link">所有行前攻略</a></div><div class="note-list"><a href="/guides/best-time-to-visit/"><span class="eyebrow">01 / 季節</span><h3>什麼時候，最適合來金門？</h3><p>春霧、夏陽與冬風，各有不同的旅行安排。</p></a><a href="/guides/kinmen-weather/"><span class="eyebrow">02 / 天氣</span><h3>下雨的那一天，也有另一種走法</h3><p>留一份室內備案，也留意航班與場館公告。</p></a><a href="/guides/packing/"><span class="eyebrow">03 / 準備</span><h3>行李輕一點，準備周到一點</h3><p>證件、好走的鞋，再帶上願意慢下來的心情。</p></a></div></section>
</Base>
