---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';
import { getImage } from 'astro:assets';
import { photo } from '../lib/photos';
interface Props { title?: string; description?: string; image?: string; noindex?: boolean; breadcrumbs?: {name: string; href?: string}[]; schema?: Record<string, unknown>[]; article?: boolean; updatedAt?: Date; }
const { title = SITE.title, description = SITE.description, image, noindex = false, breadcrumbs = [], schema = [], article = false, updatedAt } = Astro.props;
const documentTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const cover = image ? photo(image) : undefined;
const og = cover ? await getImage({ src: cover.src, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 85 }) : {src:'/og-guide.jpg'};
const ogUrl = new URL(og.src, SITE.url).href;
const graph: Record<string,unknown>[] = [
  {'@type':'Organization','@id':`${SITE.url}/#organization`,name:SITE.name,url:SITE.url},
  {'@type':'WebSite','@id':`${SITE.url}/#website`,name:SITE.name,url:SITE.url,inLanguage:SITE.locale,publisher:{'@id':`${SITE.url}/#organization`}},
  {'@type':'WebPage','@id':canonical,name:title,description,url:canonical,inLanguage:SITE.locale,isPartOf:{'@id':`${SITE.url}/#website`}},
  ...(breadcrumbs.length ? [{'@type':'BreadcrumbList',itemListElement:[{name:'首頁',href:'/'},...breadcrumbs].map((b,index) => ({'@type':'ListItem',position:index+1,name:b.name,item:new URL(b.href ?? Astro.url.pathname,SITE.url).href}))}] : []),
  ...schema,
];
---
<!doctype html><html lang="zh-Hant-TW"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{documentTitle}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}/><meta name="theme-color" content="#a43e2e"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><meta property="og:locale" content="zh_TW"/><meta property="og:site_name" content={SITE.name}/><meta property="og:type" content={article ? 'article' : 'website'}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={ogUrl}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content={cover?.alt ?? 'Kinmen Guide 金門旅遊指南品牌封面'}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={ogUrl}/>{updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()}/>}<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':graph}).replace(/</g,'\\u003c')}/></head><body><a href="#main" class="skip-link">跳至主要內容</a><Header/><main id="main"><slot/></main><Footer/></body></html>
