---
import Photo from './Photo.astro';
import { areaNames } from '../data/site';
import { entryHref, type Entry } from '../lib/content';
interface Props { entry: Entry; compact?: boolean; }
const { entry, compact = false } = Astro.props;
const d = entry.data;
---
<article class:list={['content-card', { compact }]} data-card data-area={d.area} data-search={`${d.title} ${d.description} ${d.nameEn} ${d.tag} ${areaNames[d.area]}`}>
  <a href={entryHref(entry)} class="card-photo" tabindex="-1" aria-hidden="true"><Photo name={d.image}/><span class="photo-tag">{d.tag}</span></a>
  <div class="card-body"><div class="card-meta"><span>{areaNames[d.area]}</span><span>{d.duration}</span></div><h3><a href={entryHref(entry)}>{d.title}</a></h3><p>{d.description}</p></div>
</article>
