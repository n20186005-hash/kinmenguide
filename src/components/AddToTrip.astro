---
import { getPublicBusinesses } from '../lib/businesses';
interface Props { id: string; title: string; }
const { id, title } = Astro.props;
const canPlan = /^(hotel|food):/.test(id) ? getPublicBusinesses().find(b => b.key === id)?.canPlan === true : true;
---
{canPlan && <button type="button" class="trip-add" data-trip-add={id} data-trip-title={title} aria-label={`加入行程：${title}`} disabled>＋ 加入行程</button>}
