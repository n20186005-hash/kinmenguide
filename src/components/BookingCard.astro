---
import { partners, officialDirectories, type Partner } from '../data/partners';
interface Props { type: Partner['type']; area?: string; }
const { type, area = 'all' } = Astro.props;
const matches = partners.filter(p => p.type === type && (area === 'all' || p.area === area));
const directory = officialDirectories[type];
const title = {hotel:'找到適合你的住宿','car-rental':'出發前，先確認你的座駕',tour:'把想了解的故事，交給在地導覽'}[type];
---
<aside class="booking-panel"><span class="eyebrow">PLAN YOUR STAY</span><h2>{title}</h2>{matches.length ? matches.map(p => <div class="partner-card"><h3>{p.name}</h3><p>{p.description}</p><a class="button" href={p.url} rel={p.sponsored ? 'sponsored noopener' : 'noopener'}>{p.sponsored ? '查看合作方案' : '查看方案'}</a>{p.sponsored && <p class="small">合作連結：若完成預訂，本站可能獲得佣金。你無需額外付費，也不會增加你的預訂費用。</p>}</div>) : <><p>先用這份攻略釐清需求，再透過官方名錄向業者確認空房、車況、費用或可預約時段。</p><a href={directory.url} class="button button-dark">{directory.label}</a><p class="small">前往外部網站查詢；本站目前不受理訂單與付款。</p></>}</aside>
