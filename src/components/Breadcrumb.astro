---
interface Props { items: { name: string; href?: string }[]; }
const { items } = Astro.props;
---
<nav class="breadcrumb" aria-label="麵包屑"><ol><li><a href="/">首頁</a></li>{items.map(item => <li>{item.href ? <a href={item.href}>{item.name}</a> : <span aria-current="page">{item.name}</span>}</li>)}</ol></nav>
