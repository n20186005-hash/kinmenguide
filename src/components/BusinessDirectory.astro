---
import AddToTrip from './AddToTrip.astro';
import CtripBooking from './CtripBooking.astro';
import { canOfferCtrip, ctripHotelFor } from '../lib/ctrip';
import { BUSINESS_PAGE_SIZE, businessPhoneHref } from '../lib/business-directory';
import { lodgingRoomNames } from '../lib/lodging-room-filters';
import { areaNames } from '../data/site';
import { getPublicBusinesses, businessCategoryNames, facilityNames, lodgingStyleNames } from '../lib/businesses';
interface Props { kind: 'food' | 'hotel'; }
const { kind } = Astro.props;
const businesses = getPublicBusinesses().filter(b => b.kind === kind);
const categories = [...new Set(businesses.map(b => kind === 'hotel' ? b.lodgingClass! : b.category))];
const facilityKeys = Object.keys(facilityNames).filter(key => businesses.some(b => b.filterFacts.includes(key)));
const hasCtripRatings = kind === 'hotel' && businesses.some(b => b.ctripFacilities?.rating);
const roomKeys = Object.keys(lodgingRoomNames).filter(key => businesses.some(b => b.roomFilters.includes(key)));
const styles = [...new Set(businesses.flatMap(b => b.lodgingStyle ? [b.lodgingStyle] : []))];
const validUntil = (date: string, days: number) => new Date(Date.parse(date + 'T00:00:00Z') + days * 86400000).toISOString().slice(0, 10);
const registrationLabels: Record<string, string> = { 'government-listed': '政府合法旅宿查詢有登載', 'historical-only': '目前登記狀態待核實（僅有歷史底冊）', pending: '目前旅宿登記待核實' };
const operationLabels: Record<string, string> = { unverified: '未獨立確認', operating: '已核實提供住宿服務', temporary_closed: '暫停營業', permanently_closed: '已停止營業' };
const batches = Array.from({ length: Math.ceil(businesses.length / BUSINESS_PAGE_SIZE) }, (_, index) => businesses.slice(index * BUSINESS_PAGE_SIZE, (index + 1) * BUSINESS_PAGE_SIZE));
const factLabels: Record<string, string> = { sourceReportedServiceOrHours: '服務與時段', serviceBasis: '住宿與服務說明', serviceDescription: '餐點與服務說明', cuisine: '餐點與用餐方式', registeredAddress: '政府登記地址與範圍', listedPhones: '政府所列聯絡電話', websiteSource: '網站入口來源', commonSpace: '公共空間', roomTypes: '房型參考', roomDetails: '業者房型補充', breakfastPolicy: '早餐方案', pickupPolicy: '接送政策', websiteDiscrepancy: '網站歸屬待核對', operatorContactDiscrepancy: '業者聯絡資料補充', bathroom: '衛浴條件', checkin: '入住方式與時間', checkout: '退房時間', luggageStorage: '行李寄放', restrictions: '入住限制', contactDiscrepancy: '聯絡資料待核對', certificateSourceDifference: '登記來源說明', laundry: '洗衣服務', mealPeriods: '供餐時段', openingHours: '營業時間', closedDays: '店休', diningOptions: '內用與外帶', reservation: '訂位', menuSource: '菜單來源' };
---
<section class="business-directory section" id="business-directory" data-business-directory data-directory-kind={kind} data-page-size={BUSINESS_PAGE_SIZE} data-business-total={businesses.length} data-business-release={kind === 'hotel' ? 'lodging20261027' : 'stay-food-2026-10-25'} aria-label={kind === 'hotel' ? '住宿店家名錄' : '餐飲店家名錄'}>
  <div class="section-heading"><div><span class="eyebrow">{kind === 'hotel' ? 'A PLACE TO STAY' : 'A TABLE ON THE ISLAND'}</span><h2>{kind === 'hotel' ? '先選生活圈，再找今晚的住宿' : '今天在哪一區，就在那一區找味道'}</h2><p>{kind === 'hotel' ? '把旅館、民宿與選區攻略放在一起比較，訂房前再向業者確認房型與條件。' : '用地區、餐飲類型與店名找一餐，把喜歡的店家放進自己的旅行清單。'}</p></div><a class="text-link" href="/trip/">安排我的行程</a></div>
  <div class="directory-note"><p>以下依官方、業者或攜程公開資料整理；核對日期是本站查閱來源的日期，不代表實地訪查、當日營業或空房保證。一般收錄不代表付費合作。</p><p class="small">{kind === 'hotel' ? '床位、獨立客房及包棟只列來源明確的住宿形式，未核實的服務不作肯定篩選。' : '各門市分開收錄；營業時段、售完、訂位與價格以店家當日公告為準。'} <a href="/contact/">提供更正或補充資料 →</a></p></div>
  <form class:list={['business-filters', { 'has-lodging-style': kind === 'hotel' && styles.length > 0 }]} data-business-form role="search" hidden>
    <label>所在地區<select class="search-input" data-business-area aria-label="所在地區"><option value="all">全島</option>{Object.entries(areaNames).filter(([key]) => key !== 'all').map(([key, label]) => <option value={key}>{label}</option>)}</select></label>
    <label>{kind === 'hotel' ? '政府登記類別' : '餐飲類型'}<select class="search-input" data-business-category aria-label={kind === 'hotel' ? '政府登記類別' : '餐飲類型'}><option value="all">全部類型</option>{categories.map(key => <option value={key}>{businessCategoryNames[key] || key}</option>)}</select></label>
    {kind === 'hotel' && styles.length > 0 && <label>住宿形式<select class="search-input" data-business-style aria-label="住宿形式"><option value="all">全部已知形式</option>{styles.map(key => <option value={key}>{lodgingStyleNames[key]}</option>)}</select></label>}
    {kind === 'hotel' && roomKeys.length > 0 && <label>房型參考<select class="search-input" data-business-room aria-label="房型參考"><option value="all">全部已知房型</option>{roomKeys.map(key => <option value={key}>{lodgingRoomNames[key]}</option>)}</select></label>}
    <label class="business-query-label">店名或地址<input class="search-input" type="search" placeholder={kind === 'hotel' ? '搜尋旅館、民宿或地址' : '搜尋店名、街道或料理'} data-business-query/></label>
    <button type="button" class="button button-light" data-business-reset>清除條件</button>
    {hasCtripRatings && <fieldset class="business-ctrip-filters"><legend>攜程資料（查閱日期起 30 天內的參考）</legend><label>攜程鑽級<select class="search-input" data-ctrip-diamond aria-label="攜程鑽級"><option value="all">全部鑽級</option><option value="2">2 鑽及以下</option><option value="3">3 鑽</option><option value="4">4 鑽</option><option value="5">5 鑽</option></select></label><label>攜程評分<select class="search-input" data-ctrip-score aria-label="攜程評分"><option value="all">全部評分</option><option value="4.7">4.7 分以上</option><option value="4.5">4.5 分以上</option><option value="4.0">4.0 分以上</option></select></label><label>攜程點評數<select class="search-input" data-ctrip-reviews aria-label="攜程點評數"><option value="all">全部點評數</option><option value="200">200 條以上</option><option value="100">100 條以上</option><option value="50">50 條以上</option></select></label></fieldset>}
    {facilityKeys.length > 0 && <fieldset class="business-facilities"><legend>來源列出的服務（訂前確認）</legend>{facilityKeys.map(key => <label><input type="checkbox" value={key} data-business-facility/>{facilityNames[key]}</label>)}</fieldset>}
  </form>
  {kind === 'hotel' && <p class="small filter-note">篩選包含官方、業者或攜程明確列出的條件；攜程資料以各卡片的查閱日期為準，未列出不代表沒有。房型與服務不代表當日供應，請預訂前確認。</p>}
  {kind === 'hotel' && <details class="directory-note"><summary>更多訂房條件，請前往攜程確認</summary><p>實際房價與房態、早餐份數、房間面積、付款方式、促銷、取消規則、開票和旅客入住資格，可能因日期、房型或方案而不同；攜程鑽級、評分與點評數為查閱日快照，超過 30 天不再納入篩選；攜程設施資料超過 90 天需重新核實。可透過住宿卡片的「查看房型・預訂房間」在攜程核對。</p></details>}
  <p class="result-count" data-business-count aria-live="polite" aria-atomic="true">共 {businesses.length} {kind === 'hotel' ? '筆住宿資料' : '家餐飲'} · 每批 {BUSINESS_PAGE_SIZE} {kind === 'hotel' ? '筆' : '家'}，可展開後續名錄 · 名錄與攻略篇數分開計算</p>
  <div class="business-list" id="business-results" data-business-list>{batches.map((batch, index) => <details class="business-batch" data-business-batch open={index === 0}>
    <summary>第 {index * BUSINESS_PAGE_SIZE + 1}–{Math.min((index + 1) * BUSINESS_PAGE_SIZE, businesses.length)} {kind === 'hotel' ? '筆' : '家'} · 展開或收合名錄</summary>
    <div class="business-grid">{batch.map(b => <article class="business-card" id={`business-${b.id}`} data-business-card data-business-key={b.key} data-area={b.area} data-category={kind === 'hotel' ? b.lodgingClass : b.category} data-style={b.lodgingStyle} data-facilities={b.filterFacts.join(' ')} data-base-facilities={b.baseFilterFacts.join(' ')} data-rooms={b.roomFilters.join(' ')} data-ctrip-checked={b.ctripFacilities?.checkedAt} data-ctrip-diamond={b.ctripFacilities?.rating?.diamond} data-ctrip-score={b.ctripFacilities?.rating?.score} data-ctrip-reviews={b.ctripFacilities?.rating?.reviews} data-search={`${b.name} ${b.aliases.join(' ')} ${b.address} ${areaNames[b.area]} ${businessCategoryNames[b.category] || b.category}`}>
    <div class="business-card-top"><span class="eyebrow">{areaNames[b.area]} / {businessCategoryNames[kind === 'hotel' ? b.lodgingClass! : b.category] || b.category}</span><span class="business-index" aria-hidden="true">{kind === 'hotel' ? '住' : '食'}</span></div>
    <h3>{b.detailHref ? <a href={b.detailHref}>{b.name}</a> : b.name}</h3><p class="business-address">{b.address}</p>
    {b.registrationNumber && <p class="small" data-business-registration-status={b.registrationStatus}>登記名稱：{b.legalName}<br/>登記字號：{b.registrationNumber}<br/>{registrationLabels[b.registrationStatus] || registrationLabels.pending}{b.registrationCheckedAt && <> · 核對 {b.registrationCheckedAt}</>}<br/><a data-business-registration-source href={b.registrationSourceUrl} target="_blank" rel="noopener noreferrer">{b.registrationStatus === 'government-listed' ? '核對政府登記來源 →' : b.registrationStatus === 'historical-only' ? '查看歷史登記來源 →' : '查看證號來源 →'}</a>{b.registrationNote && <><br/>{b.registrationNote}</>}</p>}
    {kind === 'hotel' && b.actualOperationStatus !== 'unverified' && <p class="small" data-business-actual-operation={b.actualOperationStatus}>實際營業：{operationLabels[b.actualOperationStatus]}{b.actualOperationCheckedAt && <> · 核對 {b.actualOperationCheckedAt}</>}</p>}
    {b.lodgingStyle && <p class="small" data-business-lodging-style={b.lodgingStyle}>住宿形式：{lodgingStyleNames[b.lodgingStyle]}</p>}
    {b.facts.filter(f => f.name === 'eligibility').map(f => <p class="alert-note">入住資格：{String(f.value)}</p>)}
    {b.ctripFacilities && <p class="small">攜程資料查閱於 {b.ctripFacilities.checkedAt}（設施參考至 {validUntil(b.ctripFacilities.checkedAt, 90)}{b.ctripFacilities.rating && <>；評分參考至 {validUntil(b.ctripFacilities.checkedAt, 30)}</>}）<span data-ctrip-stale></span><span data-ctrip-rating-snapshot>{b.ctripFacilities.rating?.diamond !== undefined && <> · {b.ctripFacilities.rating.diamond} 鑽</>}{b.ctripFacilities.rating?.score !== undefined && <> · {b.ctripFacilities.rating.score} / 5 分</>}{b.ctripFacilities.rating?.reviews !== undefined && <> · {b.ctripFacilities.rating.reviews} 則點評</>}</span> · <a href={ctripHotelFor(b.id)?.url} target="_blank" rel="noopener noreferrer">查看攜程酒店資訊</a>{b.ctripFacilityConflicts.length > 0 && <> · {b.ctripFacilityConflicts.map(key => facilityNames[key] || key).join('、')}資料有差異，請向酒店確認</>}</p>}
    {b.filterFacts.length > 0 && <ul class="business-tags" aria-label="來源列出的服務">{b.filterFacts.map(key => <li data-platform-only={!b.baseFilterFacts.includes(key) ? 'true' : undefined}>{facilityNames[key] || key}</li>)}</ul>}
    {b.facts.filter(f => b.filterFacts.includes(f.name) && f.note).map(f => <p class="small">{f.note} {f.sourceType === 'user-provided' ? <span>用戶提供 · {f.checkedAt}</span> : <a href={f.sourceUrl} target="_blank" rel="noopener noreferrer">來源 · {f.checkedAt}</a>}</p>)}
    {kind === 'food' && b.facts.filter(f => f.name === 'sourceReportedSundayScheduleAndService').map(f => <details class="small"><summary>來源列出的週日時段／服務參考</summary><p>{String(f.value)}</p><p>不代表當日供餐保證；其他日期與最後點餐請查來源或向店家確認。</p></details>)}
    {b.facts.filter(f => factLabels[f.name]).map(f => <details class="small" data-business-fact={f.name}><summary>{factLabels[f.name]}</summary><p>{String(f.value)}</p>{f.note && <p>{f.note}</p>}{f.sourceType === 'user-provided' ? <span>用戶提供 · {f.checkedAt}</span> : <a href={f.sourceUrl} target="_blank" rel="noopener noreferrer">核對此項來源 · {f.checkedAt}</a>}</details>)}
    <p class:list={['small', { 'business-closed': ['temporary_closed', 'permanently_closed'].includes(b.state) }]}>{b.notice}</p>
    <div class="business-actions">{b.detailHref && <a href={b.detailHref}>閱讀店家攻略</a>}{kind === 'hotel' && canOfferCtrip(b.state, b.actualOperationStatus) && <CtripBooking id={b.id} placement="directory"/>}{b.phone && <a href={businessPhoneHref(b.phone)}>致電 {b.phone}</a>}{b.website && <a href={b.website} target="_blank" rel="noopener noreferrer">{b.websiteLabel}</a>}{b.verifiedMapUrl && <a data-business-verified-map href={b.verifiedMapUrl} target="_blank" rel="noopener noreferrer">已核對店家地圖</a>}<a data-business-address-search href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(b.address + ' ' + b.name)}`} target="_blank" rel="noopener noreferrer">以店名地址搜尋</a><a href={b.sourceUrl} target="_blank" rel="noopener noreferrer">資料來源</a></div>
    <div class="business-card-bottom"><span class="small">{kind === 'hotel' ? b.state === 'unverified' ? '基本資料來源核對' : '服務來源核對' : '來源核對'} {b.checkedAt}</span>{b.canPlan && <AddToTrip id={b.key} title={b.name}/>}</div>
  </article>)}</div></details>)}</div>
  <nav class="business-pagination" data-business-pagination aria-label="店家名錄分頁" hidden>
    <button type="button" class="button button-light" data-business-previous aria-controls="business-results">上一頁</button>
    <span data-business-page></span>
    <button type="button" class="button button-light" data-business-next aria-controls="business-results">下一頁</button>
  </nav>
  <div class="empty-state" data-business-empty hidden><h3>這組條件暫時沒有店家</h3><p>清除條件或改看同區攻略；未知服務不會列入肯定篩選。</p><button type="button" class="button button-light" data-business-reset>顯示全部店家</button></div>
  {kind === 'hotel' && <p class="small" data-affiliate-disclosure>部分住宿使用第三方推廣連結；透過本站推廣連結完成預訂，本站可能獲得佣金。價格及預訂條件以合作平台最終頁面為準。</p>}
  <noscript><p class="directory-note">未啟用 JavaScript，可逐批展開全部已收錄店家；電話、地址、來源和攻略連結仍可使用。</p></noscript>
</section>
<script>
import { normalizeSearch } from '../lib/search';
import { BUSINESS_PAGE_SIZE, paginateBusinesses } from '../lib/business-directory';
document.querySelectorAll<HTMLElement>('[data-business-directory]').forEach(root => {
  const lodging = root.dataset.directoryKind === 'hotel';
  const cards = [...root.querySelectorAll<HTMLElement>('[data-business-card]')];
  const list = root.querySelector<HTMLElement>('[data-business-list]')!;
  const area = root.querySelector<HTMLSelectElement>('[data-business-area]')!;
  const category = root.querySelector<HTMLSelectElement>('[data-business-category]')!;
  const style = root.querySelector<HTMLSelectElement>('[data-business-style]');
  const room = root.querySelector<HTMLSelectElement>('[data-business-room]');
  const diamond = root.querySelector<HTMLSelectElement>('[data-ctrip-diamond]');
  const score = root.querySelector<HTMLSelectElement>('[data-ctrip-score]');
  const reviews = root.querySelector<HTMLSelectElement>('[data-ctrip-reviews]');
  const query = root.querySelector<HTMLInputElement>('[data-business-query]')!;
  const facilities = [...root.querySelectorAll<HTMLInputElement>('[data-business-facility]')];
  const pagination = root.querySelector<HTMLElement>('[data-business-pagination]')!;
  const previous = root.querySelector<HTMLButtonElement>('[data-business-previous]')!;
  const next = root.querySelector<HTMLButtonElement>('[data-business-next]')!;
  const fresh = (card: HTMLElement, days: number) => { const checked = Date.parse((card.dataset.ctripChecked || '') + 'T00:00:00Z'); const age = Date.now() - checked; return Number.isFinite(age) && age >= 0 && age < (days + 1) * 86400000; };
  cards.forEach(card => {
    if (card.dataset.ctripChecked && !fresh(card, 90)) { card.querySelectorAll<HTMLElement>('[data-platform-only]').forEach(tag => tag.hidden = true); const note = card.querySelector('[data-ctrip-stale]'); if (note) note.textContent = '（設施資料已過期，請重新核實）'; }
    if (card.dataset.ctripChecked && !fresh(card, 30)) { const rating = card.querySelector<HTMLElement>('[data-ctrip-rating-snapshot]'); if (rating) rating.hidden = true; const note = card.querySelector('[data-ctrip-stale]'); if (note && fresh(card, 90)) note.textContent = '（評分及點評快照已過期）'; }
  });
  const searchable = new Map(cards.map(card => [card, normalizeSearch(card.dataset.search || '')]));
  let currentPage = 1;
  // Keep every public card in server HTML; JS only replaces the native disclosure layout.
  cards.forEach(card => list.append(card));
  root.querySelectorAll('[data-business-batch]').forEach(batch => batch.remove());
  list.classList.add('business-grid');
  root.querySelector<HTMLFormElement>('[data-business-form]')!.hidden = false;
  const requested = new URLSearchParams(location.search).get('area');
  if ([...area.options].some(o => o.value === requested)) area.value = requested!;
  function matches() {
    const q = normalizeSearch(query.value), selected = facilities.filter(f => f.checked).map(f => f.value);
    const wantsRating = [diamond, score, reviews].some(f => f && f.value !== 'all');
    return cards.filter(card => (!wantsRating || (() => {
            const value = (x: string | undefined) => x === undefined || x === '' ? null : Number(x);
      const d = value(card.dataset.ctripDiamond), s = value(card.dataset.ctripScore), r = value(card.dataset.ctripReviews);
      return fresh(card, 30)
        && (!diamond || diamond.value === 'all' || (d !== null && (diamond.value === '2' ? d <= 2 : d === Number(diamond.value))))
        && (!score || score.value === 'all' || (s !== null && s >= Number(score.value)))
        && (!reviews || reviews.value === 'all' || (r !== null && r >= Number(reviews.value)));
    })()) && (area.value === 'all' || card.dataset.area === area.value)
      && (category.value === 'all' || card.dataset.category === category.value)
      && (!style || style.value === 'all' || card.dataset.style === style.value)
      && (!room || room.value === 'all' || (card.dataset.rooms || '').split(' ').includes(room.value))
      && searchable.get(card)!.includes(q)
      && selected.every(key => ((fresh(card, 90) ? card.dataset.facilities : card.dataset.baseFacilities) || '').split(' ').includes(key)));
  }
  function update() {
    const result = paginateBusinesses(matches(), currentPage);
    currentPage = result.page;
    const visible = new Set(result.items);
    cards.forEach(card => card.hidden = !visible.has(card));
    root.querySelector('[data-business-count]')!.textContent = `找到 ${result.total} ${lodging ? '筆住宿資料' : '家店家'} · 目前顯示 ${result.first}–${result.last} ${lodging ? '筆' : '家'} · 名錄與攻略篇數分開計算`;
    root.querySelector<HTMLElement>('[data-business-empty]')!.hidden = result.total !== 0;
    pagination.hidden = result.pages <= 1;
    previous.disabled = result.page <= 1;
    next.disabled = result.page >= result.pages;
    root.querySelector('[data-business-page]')!.textContent = `第 ${result.page} / ${result.pages} 頁 · 每頁 ${BUSINESS_PAGE_SIZE} ${lodging ? '筆' : '家'}`;
  }
  function clearFilters() {
    area.value = 'all'; category.value = 'all'; query.value = ''; facilities.forEach(f => f.checked = false);
    if (style) style.value = 'all';
    if (room) room.value = 'all';
    [diamond, score, reviews].forEach(f => { if (f) f.value = 'all'; });
    currentPage = 1;
  }
  function changeFilters() { currentPage = 1; update(); }
  function showAnchor() {
    // Resolve against the known cards instead of inserting an arbitrary hash into a selector.
    let id: string;
    try { id = decodeURIComponent(location.hash.slice(1)); } catch { return; }
    const target = cards.find(card => card.id === id);
    if (!target) return;
    if (!matches().includes(target)) clearFilters();
    currentPage = Math.floor(matches().indexOf(target) / BUSINESS_PAGE_SIZE) + 1;
    update();
    target.tabIndex = -1;
    requestAnimationFrame(() => { target.focus({ preventScroll: true }); target.scrollIntoView({ block: 'start' }); });
  }
  root.querySelector('form')?.addEventListener('submit', event => event.preventDefault());
  area.addEventListener('change', changeFilters); category.addEventListener('change', changeFilters); query.addEventListener('input', changeFilters);
  style?.addEventListener('change', changeFilters); room?.addEventListener('change', changeFilters);
  [diamond, score, reviews].forEach(f => f?.addEventListener('change', changeFilters));
  facilities.forEach(f => f.addEventListener('change', changeFilters));
  root.querySelectorAll('[data-business-reset]').forEach(button => button.addEventListener('click', () => { clearFilters(); update(); query.focus(); }));
  [[previous, -1], [next, 1]].forEach(([button, step]) => (button as HTMLButtonElement).addEventListener('click', () => {
    currentPage += step as number; update();
    root.querySelector<HTMLElement>('[data-business-count]')!.scrollIntoView({ block: 'start' });
  }));
  window.addEventListener('hashchange', showAnchor);
  update();
  showAnchor();
});
</script>
